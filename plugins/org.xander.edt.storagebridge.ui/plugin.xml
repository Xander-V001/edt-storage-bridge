<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
  <extension point="org.eclipse.ui.commands">
    <command
      id="org.xander.edt.storagebridge.ui.inspectProject"
      name="%command.inspect"/>
  </extension>
  <extension point="org.eclipse.ui.handlers">
    <handler
      commandId="org.xander.edt.storagebridge.ui.inspectProject"
      class="org.xander.edt.storagebridge.ui.InspectProjectHandler"/>
  </extension>
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
      <menu id="org.xander.edt.storagebridge.ui.menu" label="%menu.bridge">
        <command commandId="org.xander.edt.storagebridge.ui.inspectProject" style="push"/>
      </menu>
    </menuContribution>
    <menuContribution locationURI="popup:org.eclipse.ui.navigator.ProjectExplorer?after=additions">
      <command commandId="org.xander.edt.storagebridge.ui.inspectProject" style="push"/>
    </menuContribution>
  </extension>
</plugin>
