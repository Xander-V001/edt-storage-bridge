<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
  <extension point="org.eclipse.ui.commands">
    <command id="org.xander.edt.storagebridge.ui.inspectProject"
      name="%command.inspect"/>
    <command id="org.xander.edt.storagebridge.ui.openStorageSettings"
      name="%command.storage"/>
    <command id="org.xander.edt.storagebridge.ui.fullReview"
      name="%command.fullReview"/>
    <command id="org.xander.edt.storagebridge.ui.outgoingReadiness"
      name="%command.outgoingReadiness"/>
    <command id="org.xander.edt.storagebridge.ui.outgoingNativeExportPreview"
      name="%command.outgoingNativeExportPreview"/>
  </extension>
  <extension point="org.eclipse.ui.handlers">
    <handler
      commandId="org.xander.edt.storagebridge.ui.inspectProject"
      class="org.xander.edt.storagebridge.ui.InspectProjectHandler"/>
    <handler
      commandId="org.xander.edt.storagebridge.ui.openStorageSettings"
      class="org.xander.edt.storagebridge.ui.OpenStorageSettingsHandler"/>
    <handler
      commandId="org.xander.edt.storagebridge.ui.fullReview"
      class="org.xander.edt.storagebridge.ui.FullStorageReviewHandler"/>
    <handler
      commandId="org.xander.edt.storagebridge.ui.outgoingReadiness"
      class="org.xander.edt.storagebridge.ui.OutgoingReadinessHandler"/>
    <handler commandId="org.xander.edt.storagebridge.ui.outgoingNativeExportPreview"
      class="org.xander.edt.storagebridge.ui.OutgoingNativeExportPreviewHandler"/>
  </extension>
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
      <menu id="org.xander.edt.storagebridge.ui.menu" label="%menu.bridge">
        <command commandId="org.xander.edt.storagebridge.ui.openStorageSettings" style="push"/>
        <command commandId="org.xander.edt.storagebridge.ui.fullReview" style="push"/>
        <command commandId="org.xander.edt.storagebridge.ui.outgoingReadiness" style="push"/>
        <command commandId="org.xander.edt.storagebridge.ui.outgoingNativeExportPreview" style="push"/>
        <command commandId="org.xander.edt.storagebridge.ui.inspectProject" style="push"/>
      </menu>
    </menuContribution>

    <!-- One-click command on the selected project across EDT Navigator and Eclipse views. -->
    <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
      <command id="org.xander.edt.storagebridge.ui.storage.popup"
        commandId="org.xander.edt.storagebridge.ui.openStorageSettings"
        label="%command.storage" style="push">
        <visibleWhen checkEnabled="false">
          <with variable="activeMenuSelection">
            <iterate operator="and" ifEmpty="false">
              <adapt type="org.eclipse.core.resources.IProject"/>
            </iterate>
          </with>
        </visibleWhen>
      </command>
    </menuContribution>
  </extension>
</plugin>
